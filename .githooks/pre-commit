#!/bin/sh
# Runs before every commit: the networks table, then typecheck, then the test suite.
#
# Installed by `npm install` via the "prepare" script, which points
# core.hooksPath at this directory. To set it up by hand:
#   git config core.hooksPath .githooks
#
# Skip it for one commit with:
#   git commit --no-verify
set -e

cd "$(git rev-parse --show-toplevel)"

# web9999/networks.json is generated from CHAIN_PRESETS in src/chain.ts, and the page fetches it as
# its chain table: a copy that lags the presets ships the wrong table to every visitor, and no test
# would notice because the tests read the presets, not the file. Cheap enough to run first.
echo "pre-commit: networks.json against the presets"
# The checker reads CHAIN_PRESETS from src/chain.ts itself - Node strips the types on import, which this
# repo already requires - so it needs no build: a fresh clone with no dist/ is checked exactly like any
# other tree, and there is nothing to skip for. No timestamps are involved either: a checkout, a restore
# or an idle touch changes file times without changing a preset, and used to decide this gate.
# exit 1 is the file disagreeing with the presets. exit 2 is a check that could not read them at all
# (no source, or the dependencies it imports are not installed): a refusal, because nothing proved the
# file right - not a pass. The hook prints the same ' REFUSED: ' line the deploy scripts do, so a
# blocked commit reads the same across the repositories.
if node deploy/networks.mjs --check; then
  :
else
  status=$?
  echo ""
  case "$status" in
    1)
      echo "  REFUSED: web9999/networks.json does not match CHAIN_PRESETS; the commit was not created."
      echo "            node deploy/networks.mjs    then stage web9999/networks.json and commit again"
      ;;
    2)
      echo "  REFUSED: the presets could not be read from src/chain.ts, so networks.json was not checked; the commit was not created."
      echo "            npm install    then commit again"
      ;;
    *)
      echo "  REFUSED: the networks.json check could not run (node exited $status); the commit was not created."
      ;;
  esac
  exit 2
fi

# explorer-x10-upload.zip is built from explorer/ and gitignored, so a machine that never built one has
# nothing to check and passes. The failure worth catching is a stale copy: it is dragged into a host's
# file manager and uploads yesterday's page, and the page itself works from the folder, so nothing else
# would notice. exit 1 is the archive disagreeing with the folder, exit 2 an archive that cannot be read
# at all - a refusal, because nothing proved it right.
echo "pre-commit: explorer upload zip against explorer/"
if node deploy/explorer-zip.mjs --check; then
  :
else
  status=$?
  echo ""
  case "$status" in
    1)
      echo "  REFUSED: explorer-x10-upload.zip does not match explorer/; the commit was not created."
      echo "            npm run explorer:zip    then commit again"
      ;;
    2)
      echo "  REFUSED: explorer-x10-upload.zip could not be read, so it was not checked; the commit was not created."
      echo "            npm run explorer:zip    then commit again"
      ;;
    *)
      echo "  REFUSED: the explorer zip check could not run (node exited $status); the commit was not created."
      ;;
  esac
  exit 2
fi

# deploy/*.ps1 are exercised by nothing: the typecheck and the test suite are TypeScript, so a broken
# probe in proxy-web9999.ps1 reaches a commit untouched and only fails on the server, where the site is
# already being changed. -SelfTest is pure (no IIS, no network) and takes about a second, so any commit
# that stages one of those scripts runs it first. It exits 1 on a failed check, which becomes this
# hook's 2: the deploy scripts' own code for a refusal.
echo "pre-commit: deploy scripts against their selftest"
staged_deploy=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '^deploy/.*\.ps1$' || true)
if [ -z "$staged_deploy" ]; then
  echo "  no deploy/*.ps1 staged; skipped"
else
  if command -v pwsh >/dev/null 2>&1; then
    ps=pwsh
  elif command -v powershell >/dev/null 2>&1; then
    ps=powershell
  else
    echo "  REFUSED: no PowerShell on PATH, so deploy/proxy-web9999.ps1 -SelfTest cannot run; the commit was not created."
    exit 2
  fi
  echo "  staged:$(printf '%s' "$staged_deploy" | tr '\n' ' ' | sed 's/^/ /')"
  if ! selftest=$("$ps" -NoProfile -ExecutionPolicy Bypass -File deploy/proxy-web9999.ps1 -SelfTest 2>&1); then
    printf '%s\n' "$selftest" | grep -E 'FAIL|selftest' | sed 's/^/        /'
    echo ""
    echo "  REFUSED: deploy/proxy-web9999.ps1 -SelfTest failed, so the proxy checks are not what they claim; the commit was not created."
    echo "            $ps -NoProfile -File deploy/proxy-web9999.ps1 -SelfTest    to see every check"
    exit 2
  fi
  printf '%s\n' "$selftest" | tail -1 | sed 's/^/        /'
fi

echo "pre-commit: typecheck"
npm run typecheck

echo "pre-commit: tests"
# Two tests skip themselves rather than fail: the browser one when no Chrome, Edge
# or Chromium is installed, and src/explorer-rpc.test.mjs when there is no php (or
# no openssl) to serve its fixture. A skip exits 0, so the suite's own summary is
# checked rather than trusted. php is optional for this repo, so its absence only
# stops a commit that touches the proxy; when php is present, any proxy skip is a
# refusal, because then something other than the missing interpreter is wrong.
test_log=$(mktemp)
if ! npm test 2>&1 | tee "$test_log"; then
  rm -f "$test_log"
  exit 1
fi
skipped=$(sed -n 's/^ℹ skipped \([0-9][0-9]*\)$/\1/p' "$test_log" | tail -1)
php_bin=${LWC_PHP:-php}
if command -v "$php_bin" >/dev/null 2>&1; then
  php_state="$php_bin is on PATH, so the proxy tests were expected to run"
else
  php_state="no php on PATH ($php_bin); set LWC_PHP to a php binary with curl and openssl"
fi
touches_proxy=no
if git diff --cached --name-only | grep -qxE '(explorer/rpc\.php|src/explorer-rpc\.test\.mjs)'; then
  touches_proxy=yes
fi
refuse() {
  echo ""
  echo "  REFUSED: $1"
  grep -E "^ℹ (tests|pass|fail|skipped|cancelled) " "$test_log" | sed 's/^/        /'
  echo "        $php_state"
  echo "        Run it alone to see why: node --test src/explorer-rpc.test.mjs"
  rm -f "$test_log"
  exit 2
}
if [ -z "$skipped" ]; then
  refuse "the suite printed no skip count, so nothing shows whether the proxy ran."
elif [ "$skipped" -gt 1 ]; then
  if command -v "$php_bin" >/dev/null 2>&1; then
    refuse "php is installed yet the proxy tests skipped, so a check did not run."
  elif [ "$touches_proxy" = yes ]; then
    refuse "this commit changes the proxy, and the tests for it would have skipped."
  else
    echo "  WARNING: the proxy tests skipped, so explorer/rpc.php was not exercised here."
    echo "           $php_state"
    echo "           Allowed because nothing staged touches the proxy; CI still runs them."
  fi
fi
rm -f "$test_log"

# Inert until a preset history is recorded; skips when the file does not exist.
echo "pre-commit: preset gate"
node scripts/pre-commit-presets.mjs --since 7d --fail-under "${LWC_FAIL_UNDER:-95}"
