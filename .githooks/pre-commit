#!/bin/sh
# Runs before every commit: typecheck first, then the test suite.
#
# Installed by `npm install` via the "prepare" script, which points
# core.hooksPath at this directory. To set it up by hand:
#   git config core.hooksPath .githooks
#
# Skip it for one commit with:
#   git commit --no-verify
set -e

cd "$(git rev-parse --show-toplevel)"

echo "pre-commit: typecheck"
npm run typecheck

echo "pre-commit: tests"
npm test

# Inert until a preset history is recorded; skips when the file does not exist.
echo "pre-commit: preset gate"
node scripts/pre-commit-presets.mjs --since 7d --fail-under "${LWC_FAIL_UNDER:-95}"
