# lwc — EVM chain connection
# Copy to .env and fill in. .env is gitignored; never commit real endpoints or tokens.

# Optional. Built-in preset: xlayer (196, OKB) or base (8453, ETH).
# A preset supplies the chain id, RPC URL, and native symbol; the settings below
# override its defaults. --chain <name|id> overrides this per command.
LWC_CHAIN=xlayer

# Custom chains only: the chain id the RPC must report. A mismatch aborts the
# connection. When LWC_CHAIN names a preset this must match it or be omitted.
# LWC_CHAIN_ID=

# Optional with a preset, required for a custom chain. http(s) JSON-RPC endpoint.
# LWC_RPC_URL=https://your-rpc.example.org

# Optional. Human label used in output (defaults to the preset name, or lwc-<chainId>).
# LWC_CHAIN_NAME=

# Optional. Native currency symbol (defaults to the preset's, otherwise ETH).
# LWC_NATIVE_SYMBOL=

# Optional. Authorization header sent to the RPC, e.g. "Bearer <token>".
# Only use this with an endpoint you trust, and prefer https.
LWC_RPC_AUTH=

# Optional. Per-request timeout in ms (250-120000, defaults to 10000).
LWC_TIMEOUT_MS=10000

# Optional. Per-endpoint Authorization header for compare, named by the endpoint
# label: drpc=https://… reads LWC_RPC_AUTH_DRPC (dashes become underscores).
# An unset or empty variable leaves the endpoint on LWC_RPC_AUTH.
# LWC_RPC_AUTH_DRPC=
